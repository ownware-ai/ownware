# Build / runtime artifacts
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo
.DS_Store

# Secrets & credentials — NEVER COMMIT (see SECURITY.md; scanner config in .gitleaks.toml)
.env
.env.*
!.env.example
*.pem
client_secret_*.json

# Engine checkpoints written relative to the CWD: running the agent in a
# project drops .ownware/checkpoints/*.json there, and those files contain
# the full conversation `messages`. Ignoring them stops `git add -A` from
# committing transcripts. (The real fix is to write them under the data
# dir instead — CLI FINDINGS F11.)
.ownware/

# Local agent state / tool dirs — machine-local, never shared
# (/memory/ is root-anchored: packages/*/src/memory/ is real source code)
.claude/
.agent/
/memory/

# Internal work/strategy docs — never published. Contains planning, commercial
# strategy, and verbatim copies of third-party repos under study (their own
# licenses); publishing any of it would be a strategy and license leak.
.catalyst/

# Owner-only private rules — never published. OWNER.md is the private twin of
# AGENTS.md/CLAUDE.md. (The commit-window git hooks live in .git/hooks/, which git
# never pushes, so they need no ignore entry here.)
OWNER.md

# Personal, machine-local ignores belong in .git/info/exclude — keep this file
# intentional and reviewable (it is part of the security surface).
